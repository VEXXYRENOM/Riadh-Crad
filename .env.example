# RIADH CARD — Environment Variables
# Copy this file to .env.local and fill in your Supabase project values.
# NEVER commit .env.local to source control.

# ── Supabase ──────────────────────────────────────────────────
# Found at: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — server-only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local development only. Never set this to true in a deployed environment.
NEXT_PUBLIC_SKIP_OTP_FOR_DEV=false

# ── Web Push (VAPID) ─────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
# Keep VAPID_PRIVATE_KEY server-only. Never commit .env.local.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:contact@your-domain.tn

# ── Google Wallet ────────────────────────────────────────────
# Choose ONE of the three credential methods below:
#
# Option 1 — Inline JSON (recommended for Vercel & local dev):
#   Paste the minified service-account JSON on a single line.
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=
#
# Option 2 — Base64-encoded JSON (alternative for Vercel):
#   base64 -w0 riadh-card-xxxx.json | pbcopy  → paste here
GOOGLE_WALLET_SERVICE_ACCOUNT_B64=
#
# Option 3 — File path (local dev only, does NOT work on Vercel):
#   Must be quoted if the path contains spaces.
# GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/to/service-account.json"
#
GOOGLE_WALLET_ISSUER_ID=your-numeric-google-wallet-issuer-id

# ── Resend (Transactional Email) ─────────────────────────────
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# "From" address shown to recipients.
# Must be from a verified domain in your Resend dashboard.
RESEND_FROM_EMAIL=Riadh Card <noreply@riadhcard.tn>
