# RIADH CARD — Environment Variables
# Copy this file to .env.local and fill in your Supabase project values.
# NEVER commit .env.local to source control.

# ── Supabase ──────────────────────────────────────────────────
# Found at: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — server-only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local development only. Never set this to true in a deployed environment.
NEXT_PUBLIC_SKIP_OTP_FOR_DEV=false

# ── Web Push (VAPID) ─────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
# Keep VAPID_PRIVATE_KEY server-only. Never commit .env.local.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:contact@your-domain.tn

# ── Google Wallet ────────────────────────────────────────────
# Service-account credentials must stay outside Git. Locally, point to the
# downloaded JSON key; in production use GOOGLE_WALLET_SERVICE_ACCOUNT_JSON.
GOOGLE_APPLICATION_CREDENTIALS="C:\Users\taki allah\Downloads\riadh-card-f129b5f59a63.json"
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=
GOOGLE_WALLET_ISSUER_ID=your-numeric-google-wallet-issuer-id
