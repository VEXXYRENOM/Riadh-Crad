# RIADH CARD — Environment Variables
# Copy this file to .env.local and fill in your Supabase project values.
# NEVER commit .env.local to source control.

# ── Supabase ──────────────────────────────────────────────────
# Found at: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — server-only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Web Push (VAPID) ─────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
# Keep VAPID_PRIVATE_KEY server-only. Never commit .env.local.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BJ9DkLsqvc3qfJP1peaHdgbXgR7Dce5MqhLSRaxcwIv7Jxe8qaxRhALBckdHxkpeW7vNcSiUj-WugF3AlWc6wdw
VAPID_PRIVATE_KEY=wYZ6zeOo5rWCtaqlcx3sapr-CD9GWK3d00Z5kKY8Q3o
VAPID_SUBJECT=mailto:contact@your-domain.tn
